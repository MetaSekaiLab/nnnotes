{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "format",
    "musicId",
    "music",
    "sounds"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "musicId": {
      "type": "integer"
    },
    "music": {
      "type": "object",
      "required": [
        "soundId"
      ],
      "properties": {
        "soundId": {
          "$ref": "#/$defs/soundId"
        }
      }
    },
    "sounds": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[1-9][0-9]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sound"
      }
    }
  },
  "$defs": {
    "soundId": {
      "type": "integer",
      "minimum": 1
    },
    "sound": {
      "type": "object",
      "required": [
        "sheet",
        "cue",
        "category",
        "categories",
        "volume",
        "row",
        "layers"
      ],
      "properties": {
        "sheet": {
          "type": "string"
        },
        "cue": {
          "type": "string"
        },
        "category": {
          "type": "integer"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "volume": {
          "type": "number",
          "minimum": 0
        },
        "row": {
          "type": "object",
          "required": [
            "_isRandomPitch"
          ],
          "properties": {
            "_isRandomPitch": {
              "const": false
            }
          }
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/layer"
          }
        }
      }
    },
    "layer": {
      "type": "object",
      "required": [
        "file",
        "sampleRate",
        "samples",
        "loopFlag",
        "loopStart",
        "loopEnd",
        "volume"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][^\\\\]*\\.(flac|m4a)$"
        },
        "sampleRate": {
          "const": 48000
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "samples": {
          "type": "integer",
          "minimum": 1
        },
        "loopFlag": {
          "type": "integer"
        },
        "loopStart": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "loopEnd": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "volume": {
          "type": "number",
          "minimum": 0
        },
        "encoderDelay": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$id": "urn:nnnotes:schema:live-music",
  "title": "live-music document"
}

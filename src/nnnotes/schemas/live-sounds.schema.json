{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "format",
    "sounds",
    "categories",
    "react",
    "noteSe",
    "liveSe",
    "timeline"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "sounds": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[1-9][0-9]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sound"
      }
    },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "react": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/react"
      }
    },
    "noteSe": {
      "type": "object",
      "required": [
        "types",
        "volumes",
        "mutes"
      ],
      "properties": {
        "types": {
          "$ref": "#/$defs/byType",
          "additionalProperties": {
            "$ref": "#/$defs/soundId"
          }
        },
        "volumes": {
          "$ref": "#/$defs/byType",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "mutes": {
          "$ref": "#/$defs/byType",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "patternId": {
          "type": "integer",
          "minimum": 1
        },
        "groups": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[1-9][0-9]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/byType",
            "additionalProperties": {
              "$ref": "#/$defs/soundId"
            }
          }
        }
      }
    },
    "liveSe": {
      "$ref": "#/$defs/byType",
      "additionalProperties": {
        "$ref": "#/$defs/soundId"
      }
    },
    "voice": {
      "type": "object",
      "properties": {
        "startVoiceSoundId": {
          "$ref": "#/$defs/optionalSoundId"
        },
        "clearVoiceSoundId": {
          "$ref": "#/$defs/optionalSoundId"
        },
        "fullComboVoiceSoundId": {
          "$ref": "#/$defs/optionalSoundId"
        },
        "allPerfectVoiceSoundId": {
          "$ref": "#/$defs/optionalSoundId"
        }
      }
    },
    "timeline": {
      "type": "object",
      "required": [
        "startCheerDelaySec"
      ],
      "properties": {
        "startCheerDelaySec": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "soundId": {
      "type": "integer",
      "minimum": 1
    },
    "optionalSoundId": {
      "type": "integer",
      "minimum": -1
    },
    "byType": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9]+$"
      }
    },
    "sound": {
      "type": "object",
      "required": [
        "sheet",
        "cue",
        "category",
        "categories",
        "volume",
        "row",
        "layers"
      ],
      "properties": {
        "sheet": {
          "type": "string"
        },
        "cue": {
          "type": "string"
        },
        "category": {
          "type": "integer"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "volume": {
          "type": "number",
          "minimum": 0
        },
        "row": {
          "type": "object",
          "required": [
            "_isRandomPitch"
          ],
          "properties": {
            "_isRandomPitch": {
              "const": false
            }
          }
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/layer"
          }
        }
      }
    },
    "layer": {
      "type": "object",
      "required": [
        "file",
        "sampleRate",
        "samples",
        "loopFlag",
        "loopStart",
        "loopEnd",
        "volume"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][^\\\\]*\\.(flac|m4a)$"
        },
        "sampleRate": {
          "const": 48000
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "samples": {
          "type": "integer",
          "minimum": 1
        },
        "loopFlag": {
          "type": "integer"
        },
        "loopStart": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "loopEnd": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "volume": {
          "type": "number",
          "minimum": 0
        },
        "encoderDelay": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "react": {
      "type": "object",
      "required": [
        "src",
        "dest",
        "level",
        "decrementMs",
        "incrementMs",
        "holdMs"
      ],
      "properties": {
        "src": {
          "type": "string"
        },
        "dest": {
          "type": "string"
        },
        "level": {
          "type": "number",
          "minimum": 0
        },
        "decrementMs": {
          "type": "number",
          "minimum": 0
        },
        "incrementMs": {
          "type": "number",
          "minimum": 0
        },
        "holdMs": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "$id": "urn:nnnotes:schema:live-sounds",
  "title": "live-sounds document"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nnnotes:schema:live-ui",
  "title": "Live start canvas text and font pages",
  "type": "object",
  "required": [
    "format",
    "language",
    "source",
    "fonts",
    "textures",
    "materials",
    "materialKeywords",
    "texts",
    "sprites",
    "coverage",
    "lineBreaking",
    "shaders",
    "musicId",
    "difficulty",
    "scene",
    "strings",
    "textStyle",
    "images",
    "jacket",
    "difficultyIcons"
  ],
  "properties": {
    "format": {
      "const": "nnnotes.live-ui/1"
    },
    "language": {
      "enum": [
        "ja",
        "en",
        "zh-Hant",
        "zh-Hans",
        "ko"
      ]
    },
    "source": {
      "enum": [
        "open",
        "game"
      ]
    },
    "fonts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "characters",
          "glyphs",
          "material",
          "fallbacks"
        ]
      }
    },
    "textures": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "texture",
          "width",
          "height"
        ],
        "properties": {
          "texture": {
            "type": "string"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "materialKeywords": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "texts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "style",
          "localized",
          "font",
          "path",
          "text",
          "setByInitialize"
        ],
        "properties": {
          "style": {
            "type": "object"
          },
          "localized": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/font"
              }
            ]
          },
          "font": {
            "$ref": "#/$defs/font"
          },
          "path": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "setByInitialize": {
            "type": "boolean"
          }
        }
      }
    },
    "sprites": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "spriteAsset",
          "m_tintAllSprites"
        ]
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "characters",
        "missing"
      ],
      "properties": {
        "characters": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "lineBreaking": {
      "type": "object",
      "required": [
        "leading",
        "following",
        "useModernHangulLineBreakingRules"
      ],
      "properties": {
        "leading": {
          "type": "string"
        },
        "following": {
          "type": "string"
        },
        "useModernHangulLineBreakingRules": {
          "type": "boolean"
        }
      }
    },
    "shaders": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "spriteAssets": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "emojiSpriteAsset": {
      "type": "string"
    },
    "musicId": {
      "type": "integer"
    },
    "difficulty": {
      "enum": [
        "easy",
        "normal",
        "hard",
        "expert"
      ]
    },
    "scene": {
      "type": "object",
      "required": [
        "manifest",
        "prefab",
        "canvas"
      ],
      "properties": {
        "manifest": {
          "type": "string"
        },
        "prefab": {
          "type": "string"
        },
        "canvas": {
          "type": "string"
        }
      }
    },
    "strings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "textStyle": {
      "type": "object"
    },
    "images": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "jacket": {
      "type": "string"
    },
    "difficultyIcons": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "font": {
      "type": "object",
      "required": [
        "fontAsset",
        "material",
        "lineSpacing"
      ],
      "properties": {
        "fontAsset": {
          "type": "string"
        },
        "material": {
          "type": "string"
        },
        "lineSpacing": {
          "type": "number"
        }
      }
    }
  }
}

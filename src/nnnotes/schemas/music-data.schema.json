{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nnnotes:schema:music-data",
  "title": "nnnotes.music-data/2",
  "description": "Every live song and chart of one master data version: song metadata in every language, chart facts and the deck model's chart statistics, with --full also the deck model's input (every chart's runtime notes and a subset of the master data tables as columns and rows). Written by `nnnotes music-data`; described in docs/music-data.md. Within the arrays of a deck input chart's `notes` (and of its `fevers`) the i-th elements belong to the same note (range): the arrays have equal lengths, which a schema cannot state. Readers ignore keys they do not know.",
  "type": "object",
  "required": [
    "format",
    "provenance",
    "languages",
    "bands",
    "characters",
    "tags",
    "categories",
    "deck",
    "songs"
  ],
  "properties": {
    "format": {
      "const": "nnnotes.music-data/2"
    },
    "provenance": {
      "type": "object",
      "required": [
        "region",
        "client",
        "catalog",
        "master",
        "exporter",
        "deck"
      ],
      "properties": {
        "region": {
          "type": "string",
          "description": "the region whose master data this is (a configured region name), or `embedded` for the master data the APK ships"
        },
        "client": {
          "type": "object",
          "required": [
            "versionName",
            "versionCode"
          ],
          "properties": {
            "versionName": {
              "type": [
                "string",
                "null"
              ],
              "description": "versionName of the APK (null without one)"
            },
            "versionCode": {
              "type": [
                "integer",
                "null"
              ],
              "description": "versionCode of the APK (null without one)"
            }
          }
        },
        "catalog": {
          "type": "object",
          "required": [
            "resourceVersion",
            "sha256"
          ],
          "properties": {
            "resourceVersion": {
              "type": [
                "string",
                "null"
              ],
              "description": "the resource version recorded for the catalog in the catalog store, null when none is recorded"
            },
            "resourceHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "description": "JP Android asset directory hash, when the catalog source is JP"
            },
            "sha256": {
              "$ref": "#/$defs/sha256",
              "description": "SHA-256 of the remote catalog file the charts were read with"
            }
          }
        },
        "master": {
          "type": "object",
          "required": [
            "source",
            "version",
            "tables"
          ],
          "properties": {
            "source": {
              "enum": [
                "api",
                "embedded"
              ],
              "description": "api: the region's files (downloaded, or with --decoded-master decoded elsewhere with their manifest); embedded: the files the APK ships"
            },
            "version": {
              "type": [
                "string",
                "null"
              ],
              "description": "`version` of the master data manifest"
            },
            "tables": {
              "type": "object",
              "description": "per table read, the SHA-256 of its file as served (before decoding; with --decoded-master as the manifest lists it)",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "sha256"
                ],
                "properties": {
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            }
          }
        },
        "exporter": {
          "type": "object",
          "required": [
            "name",
            "version",
            "chartFormat"
          ],
          "properties": {
            "name": {
              "const": "nnnotes"
            },
            "version": {
              "type": "string"
            },
            "chartFormat": {
              "type": "string",
              "description": "format of the chart converter the notes come from (nnnotes.live-score/1)"
            }
          }
        },
        "deck": {
          "type": [
            "object",
            "null"
          ],
          "description": "the deck model the statistics come from; null without it (--no-deck)",
          "required": [
            "name",
            "version",
            "source",
            "commit",
            "sourceSha256",
            "format"
          ],
          "properties": {
            "name": {
              "const": "ournotes-deck"
            },
            "version": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "description": "the repository"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "sourceSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "the SHA-256 of the deck model's sources; releases with the same value measure the same statistics"
            },
            "format": {
              "const": "ournotes-deck.chart-stats/3",
              "description": "The native nominal-expectation statistics format."
            }
          }
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "$ref": "#/$defs/text"
          },
          "mainColor": {
            "type": [
              "string",
              "null"
            ]
          },
          "subColor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "$ref": "#/$defs/text"
          },
          "bandId": {
            "type": [
              "integer",
              "null"
            ]
          },
          "shortName": {
            "$ref": "#/$defs/text"
          },
          "mainColor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "$ref": "#/$defs/text"
          },
          "musicCategories": {
            "$ref": "#/$defs/ints"
          }
        }
      }
    },
    "gekisouCatalog": {
      "type": "object",
      "description": "the Gekisou skills a deck brings to a Gekisou live and the cards that carry them, every list sorted by id (docs/music-data.md, gekisouCatalog)",
      "required": [
        "skills",
        "supportSkills",
        "members",
        "snaps"
      ],
      "properties": {
        "skills": {
          "type": "array",
          "description": "MasterGekisouSkill: the member cards' Gekisou skills",
          "items": {
            "$ref": "#/$defs/gekisouSkill"
          }
        },
        "supportSkills": {
          "type": "array",
          "description": "MasterGekisouSupportSkill: the snaps' Gekisou support skills",
          "items": {
            "$ref": "#/$defs/gekisouSkill"
          }
        },
        "members": {
          "type": "array",
          "description": "MasterMemberCard",
          "items": {
            "type": "object",
            "required": [
              "id",
              "characterId",
              "bandId",
              "rarity",
              "gekisouSkillId",
              "name",
              "subtitle"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "characterId": {
                "type": "integer"
              },
              "bandId": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "the character's band"
              },
              "rarity": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "gekisouSkillId": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "_gekisouSkillID (a skills[] id); null for 0"
              },
              "name": {
                "$ref": "#/$defs/text",
                "description": "_nameTextID"
              },
              "subtitle": {
                "$ref": "#/$defs/text",
                "description": "_subtitleTextID: the card's title"
              }
            }
          }
        },
        "snaps": {
          "type": "array",
          "description": "MasterSupportCard",
          "items": {
            "type": "object",
            "required": [
              "id",
              "characterIds",
              "rarity",
              "gekisouSupportSkillIds",
              "supportSkillLevel",
              "name",
              "subtitle"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "characterIds": {
                "$ref": "#/$defs/ints"
              },
              "rarity": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "gekisouSupportSkillIds": {
                "$ref": "#/$defs/ints",
                "description": "_gekisouSupportSkillId01 / 02 that are not 0 (supportSkills[] ids)"
              },
              "supportSkillLevel": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "the level of its Gekisou support skills at the snap's highest rank (MasterSupportCardRank)"
              },
              "name": {
                "$ref": "#/$defs/text",
                "description": "_nameTextID"
              },
              "subtitle": {
                "$ref": "#/$defs/text",
                "description": "_descriptionTextID: the snap's title"
              }
            }
          }
        }
      }
    },
    "deck": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "model",
        "kinds",
        "gekisouAptitude"
      ],
      "description": "the deck model's measurement and score-up kinds; null with --no-deck",
      "properties": {
        "model": {
          "type": "object"
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "effectType"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "effectType": {
                "type": "integer"
              }
            }
          }
        },
        "gekisouAptitude": {
          "$ref": "#/$defs/gekisouAptitude"
        }
      }
    },
    "songs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/song"
      }
    },
    "master": {
      "type": "object",
      "description": "--full: the deck input's tables by name; a table not present reads as empty",
      "additionalProperties": {
        "$ref": "#/$defs/table"
      }
    },
    "charts": {
      "type": "array",
      "description": "--full: one chart per MasterLiveMusicScore row, sorted by scoreId",
      "items": {
        "$ref": "#/$defs/chart"
      }
    },
    "replay": {
      "type": "object",
      "required": [
        "format",
        "manifestUrl",
        "sha256",
        "charts"
      ],
      "properties": {
        "format": {
          "const": "nnnotes.replay-manifest/1"
        },
        "manifestUrl": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "charts": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Optional normalized replay artifact manifest, URL relative to the music-data URL; shared Rust/WASM engine only."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ints": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "table": {
      "type": "object",
      "required": [
        "columns",
        "rows"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array"
          },
          "description": "one array per row, one value per column in the order of `columns`"
        }
      }
    },
    "chart": {
      "type": "object",
      "required": [
        "scoreId",
        "asset",
        "notes",
        "skillEvents",
        "fevers"
      ],
      "properties": {
        "scoreId": {
          "type": "integer",
          "description": "MasterLiveMusicScore._id"
        },
        "asset": {
          "type": "object",
          "required": [
            "key",
            "sha256"
          ],
          "properties": {
            "key": {
              "type": "string",
              "description": "Live/MusicScore/<_musicScoreTextFileName>"
            },
            "sha256": {
              "$ref": "#/$defs/sha256",
              "description": "SHA-256 of the chart TextAsset's bytes as shipped"
            }
          }
        },
        "notes": {
          "type": "object",
          "required": [
            "id",
            "op",
            "judgementType",
            "timeMs"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/ints",
              "description": "note id, unique within the chart"
            },
            "op": {
              "$ref": "#/$defs/ints",
              "description": "NoteOperateType"
            },
            "judgementType": {
              "$ref": "#/$defs/ints",
              "description": "NoteJudgementType"
            },
            "timeMs": {
              "$ref": "#/$defs/ints",
              "description": "note time in chart milliseconds"
            }
          }
        },
        "skillEvents": {
          "type": "object",
          "required": [
            "timeMs"
          ],
          "properties": {
            "timeMs": {
              "$ref": "#/$defs/ints",
              "description": "skill event times in chart order (the index is the event index)"
            }
          }
        },
        "fevers": {
          "type": "object",
          "required": [
            "startMs",
            "endMs"
          ],
          "properties": {
            "startMs": {
              "$ref": "#/$defs/ints",
              "description": "range starts, sorted (the index is the range index)"
            },
            "endMs": {
              "$ref": "#/$defs/ints"
            }
          }
        }
      }
    },
    "text": {
      "type": [
        "object",
        "null"
      ],
      "description": "one string per language of `languages`; null: no text id",
      "required": [
        "ja",
        "en",
        "zh-Hant",
        "zh-Hans",
        "ko"
      ],
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "gekisouSkill": {
      "type": "object",
      "required": [
        "id",
        "mission",
        "maxLevel",
        "name",
        "description"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "mission": {
          "type": [
            "integer",
            "null"
          ],
          "description": "_gekisouMissionType: 1 combo, 2 luck, 3 Just count, 4 every mission"
        },
        "maxLevel": {
          "type": "integer",
          "minimum": 0,
          "description": "the highest _level of the skill's effect rows, 0 without one"
        },
        "name": {
          "$ref": "#/$defs/text",
          "description": "_nameTextID"
        },
        "description": {
          "$ref": "#/$defs/text",
          "description": "_descriptionTextFormatID: the format text with its placeholders"
        }
      }
    },
    "deckChart": {
      "type": [
        "object",
        "null"
      ],
      "description": "the chart's deck statistics (docs/music-data.md, Deck statistics); null with --no-deck",
      "required": [
        "convertedNoteCount",
        "skip",
        "events",
        "positions",
        "ranges",
        "justNotes",
        "unplayable",
        "expectation",
        "replaySeeds",
        "offSeeds",
        "gekisouAptitude"
      ],
      "properties": {
        "convertedNoteCount": {
          "type": "integer"
        },
        "skip": {
          "type": "number"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "description": "[performance position, time ms] per skill event, in chart order"
        },
        "positions": {
          "type": "integer",
          "minimum": 0
        },
        "ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "mission",
              "startMs",
              "endMs",
              "rankBonusPercent",
              "rankBonusPercents"
            ],
            "properties": {
              "index": {
                "type": "integer"
              },
              "mission": {
                "type": "integer"
              },
              "startMs": {
                "type": "integer"
              },
              "endMs": {
                "type": "integer"
              },
              "rankBonusPercent": {
                "type": "integer",
                "description": "the rank 1 bonus percentage (rankBonusPercents[0])"
              },
              "rankBonusPercents": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 5,
                "maxItems": 5,
                "description": "the rank bonus percentages of ranks 1..5 of the song's mission pattern"
              }
            }
          }
        },
        "justNotes": {
          "type": "integer",
          "minimum": 0
        },
        "offSeeds": {
          "type": "array",
          "description": "the measurements with Gekisou off (a solo live), one seed",
          "items": {
            "type": "object",
            "required": [
              "seed",
              "score",
              "weights",
              "check"
            ],
            "properties": {
              "seed": {
                "const": 0
              },
              "score": {
                "type": "integer",
                "description": "the exact no-skill score at model.power, Gekisou off"
              },
              "weights": {
                "type": "array",
                "items": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "number"
                  }
                },
                "description": "weights[kind][position], Gekisou off; a kind null when its conditions read the Gekisou state"
              },
              "check": {
                "type": "object",
                "required": [
                  "deck",
                  "exact",
                  "predicted",
                  "bound"
                ],
                "properties": {
                  "deck": {
                    "type": "array",
                    "items": {
                      "type": [
                        "array",
                        "null"
                      ]
                    }
                  },
                  "exact": {
                    "type": "integer"
                  },
                  "predicted": {
                    "type": "number"
                  },
                  "bound": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "minItems": 1,
          "maxItems": 1
        },
        "unplayable": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the game cannot play the chart with Gekisou; expectation is then null and replaySeeds empty, while offSeeds remains available."
        },
        "gekisouAptitude": {
          "$ref": "#/$defs/chartGekisouAptitude"
        },
        "expectation": {
          "anyOf": [
            {
              "$ref": "#/$defs/expectedStats"
            },
            {
              "type": "null"
            }
          ],
          "description": "Expected Gekisou scores under independent nominal lottery and skill probabilities; null when unplayable."
        },
        "replaySeeds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "description": "Whole-live replay examples. Changing this prefix does not change expectations."
        }
      }
    },
    "songChart": {
      "type": "object",
      "required": [
        "difficulty",
        "scoreId",
        "level",
        "displayLevel",
        "fullComboCount",
        "asset",
        "notes",
        "bpm",
        "firstNoteMs",
        "lastJudgedNoteMs",
        "lastNoteMs",
        "musicLengthMs",
        "skillEventsMs",
        "fevers",
        "deck"
      ],
      "properties": {
        "difficulty": {
          "enum": [
            "easy",
            "normal",
            "hard",
            "expert"
          ]
        },
        "scoreId": {
          "type": "integer"
        },
        "level": {
          "type": "integer"
        },
        "displayLevel": {
          "type": [
            "number",
            "null"
          ]
        },
        "fullComboCount": {
          "type": "integer"
        },
        "asset": {
          "type": "object",
          "required": [
            "key",
            "sha256"
          ],
          "properties": {
            "key": {
              "type": "string",
              "description": "Live/MusicScore/<_musicScoreTextFileName>"
            },
            "sha256": {
              "$ref": "#/$defs/sha256",
              "description": "SHA-256 of the chart TextAsset's bytes as shipped"
            }
          }
        },
        "notes": {
          "type": "object",
          "required": [
            "judged",
            "total",
            "byOperateType"
          ],
          "properties": {
            "judged": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            },
            "byOperateType": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            }
          }
        },
        "bpm": {
          "type": "object",
          "required": [
            "main",
            "min",
            "max",
            "changes"
          ],
          "properties": {
            "main": {
              "type": "number"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "changes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "timeMs",
                  "bpm"
                ],
                "properties": {
                  "timeMs": {
                    "type": "integer"
                  },
                  "bpm": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "firstNoteMs": {
          "type": "integer"
        },
        "lastJudgedNoteMs": {
          "type": "integer"
        },
        "lastNoteMs": {
          "type": "integer"
        },
        "musicLengthMs": {
          "type": "integer"
        },
        "skillEventsMs": {
          "$ref": "#/$defs/ints"
        },
        "fevers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ints",
            "minItems": 2,
            "maxItems": 2
          }
        },
        "deck": {
          "$ref": "#/$defs/deckChart"
        }
      }
    },
    "song": {
      "type": "object",
      "required": [
        "id",
        "sortOrder",
        "startAt",
        "defaultUnlock",
        "title",
        "ruby",
        "phonetic",
        "bandIds",
        "bandName",
        "vocalCharacterIds",
        "lyricist",
        "composer",
        "arranger",
        "musicType",
        "musicCategories",
        "bestMusicTagIds",
        "jacket",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "product",
    "subject",
    "files",
    "objects"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "nnnotes.product/1"
    },
    "product": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_][^\\\\]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/file"
      }
    },
    "objects": {
      "type": "object",
      "propertyNames": {
        "pattern": "^.+:-?[0-9]+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "class",
          "files"
        ],
        "additionalProperties": false,
        "properties": {
          "class": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "files": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/file"
            }
          }
        }
      }
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "enum": [
        "ja",
        "en",
        "zh-Hant",
        "zh-Hans",
        "ko"
      ]
    },
    "options": {
      "type": "object",
      "properties": {
        "LiveQuality": {
          "type": "array",
          "items": {
            "enum": [
              0,
              1,
              2
            ]
          },
          "minItems": 1
        }
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "audio": {
      "type": "boolean"
    }
  },
  "$defs": {
    "file": {
      "anyOf": [
        {
          "$ref": "#/$defs/whole"
        },
        {
          "$ref": "#/$defs/encoded"
        },
        {
          "$ref": "#/$defs/parts"
        }
      ]
    },
    "asset": {
      "type": "string",
      "pattern": "^assets/[0-9a-f]{64}\\.[a-z0-9]+$"
    },
    "encodedAsset": {
      "type": "string",
      "pattern": "^assets/[0-9a-f]{64}\\.[a-z0-9]+\\.(gz|br)$"
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "stored": {
      "type": "integer",
      "minimum": 0
    },
    "whole": {
      "type": "object",
      "required": [
        "asset",
        "size"
      ],
      "additionalProperties": false,
      "properties": {
        "asset": {
          "$ref": "#/$defs/asset"
        },
        "size": {
          "$ref": "#/$defs/size"
        }
      }
    },
    "encoded": {
      "type": "object",
      "required": [
        "asset",
        "size",
        "stored"
      ],
      "additionalProperties": false,
      "properties": {
        "asset": {
          "$ref": "#/$defs/encodedAsset"
        },
        "size": {
          "$ref": "#/$defs/size"
        },
        "stored": {
          "$ref": "#/$defs/stored"
        }
      }
    },
    "parts": {
      "type": "object",
      "required": [
        "parts",
        "size"
      ],
      "additionalProperties": false,
      "properties": {
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/asset"
                  },
                  {
                    "$ref": "#/$defs/size"
                  }
                ],
                "minItems": 3,
                "maxItems": 3
              },
              {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/encodedAsset"
                  },
                  {
                    "$ref": "#/$defs/size"
                  },
                  {
                    "$ref": "#/$defs/stored"
                  }
                ],
                "minItems": 4,
                "maxItems": 4
              }
            ]
          }
        },
        "size": {
          "$ref": "#/$defs/size"
        }
      }
    }
  },
  "$id": "urn:nnnotes:schema:product",
  "title": "nnnotes.product/1"
}

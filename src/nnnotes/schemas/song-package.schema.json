  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nnnotes:schema:song-package",
  "type": "object",
  "properties": {
    "format": {
      "const": "nnnotes.song-package/1"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "template_song": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },

                  "enum": [
                    44100,
                    48000
                  ]
                },
                "channels": {
                  "enum": [
                    1,
                    2
                  ]
                },
                "stream": {
                  "type": "integer",
                  "minimum": 0
                },
                "gain_db": {
                  "type": "number",
                  "minimum": -120,
                  "maximum": 24
                },
                "start_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "fade_in_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "fade_out_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "quality": {
                  "enum": [
                    "highest",
                    "high",
                    "middle",
                    "low",
                    "lowest"
                  ]
                }
              },
              "required": [
                "file"
              ],
              "additionalProperties": false
            },
            "preview": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "from": {
                  "const": "full"
                },
                "sample_rate": {
                  "enum": [
                    44100,
                    48000
                  ]
                },
                "channels": {
                  "enum": [
                    1,
                    2
                  ]
                },
                "stream": {
                  "type": "integer",
                  "minimum": 0
                },
                "gain_db": {
                  "type": "number",
                  "minimum": -120,
                  "maximum": 24
                },
                "start_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "fade_in_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "fade_out_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "quality": {
                  "enum": [
                    "highest",
                    "high",
                    "middle",
                    "low",
                    "lowest"
                  ]
                }
              },
              "required": [],
              "additionalProperties": false,
              "oneOf": [
                {
                  "required": [
                    "file"
                  ],
                  "not": {
                    "required": [
                      "from"
                    ]
                  }
                },
                {
                  "required": [
                    "from",
                    "start_ms",
                    "duration_ms"
                  ],
                  "not": {
                    "required": [
                      "file"
                    ]
                  }
                }
              ]
            },
            "processing": {
              "type": "object",
              "properties": {
                "sample_rate": {
                  "enum": [
                    44100,
                    48000
                  ]
                },
                "channels": {
                  "enum": [
                    1,
                    2
                  ]
                },
                "stream": {
                  "type": "integer",
                  "minimum": 0
                },
                "gain_db": {
                  "type": "number",
                  "minimum": -120,
                  "maximum": 24
                },
                "start_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "fade_in_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "fade_out_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "quality": {
                  "enum": [
                    "highest",
                    "high",
                    "middle",
                    "low",
                    "lowest"
                  ]
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "full",
            "preview"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "jacket",
        "audio"
      ],
      "additionalProperties": false

      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "title": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "ja",
                  "en",
                  "zh-Hant",
                  "zh-Hans",
                  "ko"
                ]
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        },
        "phonetic": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "ja",
                  "en",
                  "zh-Hant",
                  "zh-Hans",
                  "ko"
                ]
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        },
        "ruby_title": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "ja",
                  "en",
                  "zh-Hant",
                  "zh-Hans",
                  "ko"
                ]
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        },
        "performer": {
          "oneOf": [
            {
              "type": "string"

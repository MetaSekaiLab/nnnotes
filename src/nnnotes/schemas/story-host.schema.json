{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nnnotes:schema:story-host",
  "title": "Overlay story host screen",
  "type": "object",
  "required": ["format", "kind", "prefabs", "cameraTarget", "overlayRoot", "layoutRoot", "openedSequences", "home", "afterlive", "graphics", "dotween", "bindings", "shaders"],
  "properties": {
    "format": {"const": "nnnotes.story-host/1"},
    "kind": {"enum": ["home", "afterlive"]},
    "prefabs": {"type": "object", "additionalProperties": {"type": "string"}},
    "cameraTarget": {"type": "string"},
    "overlayRoot": {"$ref": "#/$defs/location"},
    "layoutRoot": {"allOf": [{"$ref": "#/$defs/location"}, {"type": "object", "required": ["fields"], "properties": {"fields": {"type": "object"}}}]},
    "openedSequences": {"type": "array", "items": {"$ref": "#/$defs/location"}},
    "home": {"type": ["object", "null"]},
    "afterlive": {"type": ["object", "null"]},
    "graphics": {"type": "object", "required": ["graphics"], "additionalProperties": {"type": "string"}},
    "dotween": {"type": "string"},
    "bindings": {"type": "object"},
    "shaders": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "$defs": {"location": {"type": "object", "required": ["prefab", "path"], "properties": {"prefab": {"type": "string"}, "path": {"type": "string"}}}}
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "format",
    "file",
    "codec",
    "width",
    "height",
    "displayWidth",
    "displayHeight",
    "frameRate",
    "frames",
    "tracks"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "file": {
      "type": "string"
    },
    "codec": {
      "type": "string"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "displayWidth": {
      "type": "integer",
      "minimum": 1
    },
    "displayHeight": {
      "type": "integer",
      "minimum": 1
    },
    "frameRate": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "frames": {
      "type": "integer",
      "minimum": 0
    },
    "tracks": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "kind",
          "channel",
          "codec"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "channel": {
            "type": "integer",
            "minimum": 0
          },
          "codec": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    }
  },
  "$id": "urn:nnnotes:schema:story-video",
  "title": "story-video document"
}

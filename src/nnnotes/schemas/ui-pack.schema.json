{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "format",
    "key",
    "roots",
    "prefabs",
    "controllers",
    "entries",
    "bindings",
    "shaders"
  ],
  "properties": {
    "format": {
      "const": "nnnotes.ui-pack/1"
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^.+:-?[0-9]+$"
      },
      "minItems": 1
    },
    "prefabs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^.+:-?[0-9]+$"
      }
    },
    "controllers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^.+:-?[0-9]+$"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "class"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "nodeCount": {
            "type": "integer",
            "minimum": 0
          },
          "classes": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "attribute"
              ],
              "properties": {
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "attribute": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "propertyNames": {
            "type": "string",
            "pattern": "^.+:-?[0-9]+$"
          }
        }
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^.+:-?[0-9]+$"
      }
    },
    "shaders": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^.+:-?[0-9]+$"
      }
    }
  },
  "$id": "urn:nnnotes:schema:ui-pack",
  "title": "UI object product"
}
